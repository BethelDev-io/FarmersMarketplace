{
  "env": {
    "node": true,
    "es2021": true,
    "jest": true
  },
  "extends": [
    "eslint:recommended",
    "prettier"
  ],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "no-console": "warn",
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_" }],
    "prefer-const": "error",
    "no-var": "error",
    "no-dupe-keys": "error",
    "no-redeclare": "error",
    "no-unreachable": "error",
    "no-dupe-class-members": "error"
  }
    "no-restricted-properties": [
      "error",
      {
        "object": "db",
        "property": "prepare",
        "message": "Use the asynchronous db.query API instead."
      }
    ]
  },
  "overrides": [
    {
      "files": ["**/*.test.js", "**/__tests__/**/*.js"],
      "rules": {
        "no-restricted-properties": "off"
      }
    }
  ]
}
